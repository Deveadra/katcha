FROM node:22-bookworm-slim

ENV NODE_ENV=production

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      ca-certificates \
      ffmpeg \
      fonts-liberation \
      libasound2 \
      libatk-bridge2.0-0 \
      libatk1.0-0 \
      libcups2 \
      libdbus-1-3 \
      libdrm2 \
      libgbm1 \
      libgtk-3-0 \
      libnss3 \
      libx11-xcb1 \
      libxcomposite1 \
      libxdamage1 \
      libxfixes3 \
      libxrandr2 \
      xdg-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY renderer/package.json ./package.json
RUN npm install --omit=dev
RUN npx remotion browser ensure
COPY renderer/src ./src

RUN useradd --create-home --uid 10001 katcha \
    && chown -R katcha:katcha /app /home/katcha
USER katcha

EXPOSE 8787
CMD ["npm", "start"]
