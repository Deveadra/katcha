# Dedicated R2 writer credentials for PostgreSQL disaster backups.
# Store as /etc/katcha/backup.env with mode 0600. Do not mount into normal Katcha services.
KATCHA_BACKUP_R2_ENDPOINT_URL=https://CHANGE_ME_ACCOUNT_ID.r2.cloudflarestorage.com
KATCHA_BACKUP_R2_ACCESS_KEY=CHANGE_ME_BACKUP_BUCKET_WRITER_ACCESS_KEY
KATCHA_BACKUP_R2_SECRET_KEY=CHANGE_ME_BACKUP_BUCKET_WRITER_SECRET_KEY
KATCHA_BACKUP_R2_SESSION_TOKEN=
KATCHA_BACKUP_R2_BUCKET=katcha-backup-prod
KATCHA_BACKUP_R2_PREFIX=postgres
KATCHA_BACKUP_R2_REGION=auto
KATCHA_BACKUP_R2_FORCE_PATH_STYLE=false
