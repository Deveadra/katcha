[Unit]
Description=Katcha R2 PostgreSQL restore verification
After=docker.service
Requires=docker.service
RequiresMountsFor=/srv/katcha

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/katcha
EnvironmentFile=/etc/katcha/katcha.env
Environment=KATCHA_REPO_ROOT=/opt/katcha
Environment=KATCHA_ENV_FILE=/etc/katcha/katcha.env
Environment=KATCHA_RESTORE_ENV_FILE=/etc/katcha/restore.env
ExecStart=/opt/katcha/deploy/scripts/postgres-restore-test.sh
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=90min
