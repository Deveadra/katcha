[Unit]
Description=Katcha verified production deployment Telegram receipt notifications
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/srv/katcha

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/sbin/katcha-production-deploy-notify
TimeoutStartSec=90s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/katcha/deployments
