KATCHA_ACQUISITION_API_URL=https://app.katcha.stream
KATCHA_ACQUISITION_CHANNEL_IDS=REPLACE_WITH_EXPLICIT_CHANNEL_UUID
# Optional host-local Netscape cookie file, mode 0600. Do not upload cookies to Katcha.
# KATCHA_ACQUISITION_COOKIE_FILE=/var/lib/katcha-acquisition/operator.cookies

# Optional CA bundle for an authorized private HTTPS control origin. TLS stays verified.
# KATCHA_ACQUISITION_CONTROL_CA_FILE=/etc/katcha-acquisition/control-ca.pem
