KATCHA_ACQUISITION_API_URL=https://app.katcha.stream
KATCHA_ACQUISITION_CHANNEL_IDS=REPLACE_WITH_EXPLICIT_CHANNEL_UUID
# Keep secrets in the three private credential files loaded by the user service.
# No OCI, Bastion, database, bucket, or interactive operator credentials are needed.
# Optional private Netscape cookie file; consent and provider permissions still apply.
# KATCHA_ACQUISITION_COOKIE_FILE=/home/REPLACE/.config/katcha-acquisition/operator.cookies
# Human verification uses a Chromium session on THIS workstation, with no inbound listener.
# Install the browser extra and matching Chromium first; API recovery must also be enabled.
KATCHA_ACQUISITION_HUMAN_RECOVERY_ENABLED=false
