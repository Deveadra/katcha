# Dedicated R2 read-only credentials for disaster restore/testing.
# Store as /etc/katcha/restore.env with mode 0600. Do not mount into normal Katcha services.
KATCHA_RESTORE_R2_ENDPOINT_URL=https://CHANGE_ME_ACCOUNT_ID.r2.cloudflarestorage.com
KATCHA_RESTORE_R2_ACCESS_KEY=CHANGE_ME_BACKUP_BUCKET_READONLY_ACCESS_KEY
KATCHA_RESTORE_R2_SECRET_KEY=CHANGE_ME_BACKUP_BUCKET_READONLY_SECRET_KEY
KATCHA_RESTORE_R2_SESSION_TOKEN=
KATCHA_RESTORE_R2_BUCKET=katcha-backup-prod
KATCHA_RESTORE_R2_PREFIX=postgres
KATCHA_RESTORE_R2_REGION=auto
KATCHA_RESTORE_R2_FORCE_PATH_STYLE=false
