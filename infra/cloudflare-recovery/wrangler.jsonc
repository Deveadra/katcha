{
  "name": "katcha-recovery-coordinator",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [
      {
        "name": "AUTHORITY",
        "class_name": "RecoveryAuthority"
      }
    ]
  },
  "exports": {
    "RecoveryAuthority": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "AUTHORITY_OBJECT_NAME": "production",
    "RECOVERY_DISPATCH_PROVIDER": "github",
    "RECOVERY_DISPATCH_URL": "https://api.github.com/repos/Deveadra/katcha/dispatches"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "recovery.katcha.stream",
      "custom_domain": true
    }
  ],
  "secrets": {
    "required": [
      "FENCE_TOKEN",
      "RECOVERY_ADMIN_TOKEN",
      "RECOVERY_CANDIDATE_TOKEN",
      "RECOVERY_DISPATCH_TOKEN",
      "EXTERNAL_COMPUTE_TOKEN"
    ]
  },
  "workers_dev": false,
  "preview_urls": false
}
