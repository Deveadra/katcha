{
  "name": "katcha-recovery-coordinator",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [
      {
        "name": "AUTHORITY",
        "class_name": "RecoveryAuthority"
      }
    ]
  },
  "exports": {
    "RecoveryAuthority": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "AUTHORITY_OBJECT_NAME": "production",
    "PAID_FALLBACK_ENABLED": "false",
    "MAX_PAID_FALLBACK_HOURS": "6",
    "MAX_PAID_FALLBACK_ESTIMATED_USD": "5",
    "PAID_REPATRIATION_LEAD_SECONDS": "1800"
  },
  "observability": {
    "enabled": true
  }
}
