# Katcha hosted production example.
# Copy values into the production secret store; do not commit the real environment.

KATCHA_ENV=production
KATCHA_RELEASE_SHA=CHANGE_ME_EXACT_40_CHARACTER_GIT_SHA
KATCHA_IMAGE_REGISTRY=ghcr.io/deveadra

# PostgreSQL and Temporal
KATCHA_POSTGRES_USER=katcha
KATCHA_POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
KATCHA_POSTGRES_DB=katcha
KATCHA_DATABASE_URL=postgresql+psycopg://katcha:CHANGE_ME_STRONG_DATABASE_PASSWORD@postgres:5432/katcha
KATCHA_TEMPORAL_HOST=temporal:7233
KATCHA_TEMPORAL_NAMESPACE=default
KATCHA_TEMPORAL_TASK_QUEUE=katcha-media
KATCHA_TEMPORAL_ANALYSIS_TASK_QUEUE=katcha-analysis
KATCHA_TEMPORAL_PRODUCTION_TASK_QUEUE=katcha-production
KATCHA_TEMPORAL_PUBLISHING_TASK_QUEUE=katcha-publishing
KATCHA_TEMPORAL_LONGFORM_TASK_QUEUE=katcha-longform
KATCHA_TEMPORAL_SQL_MAX_CONNS=5
KATCHA_TEMPORAL_SQL_MAX_IDLE_CONNS=2
KATCHA_TEMPORAL_SQL_VIS_MAX_CONNS=2
KATCHA_TEMPORAL_SQL_VIS_MAX_IDLE_CONNS=1

# Cloudflare R2. Use a token scoped to the production media bucket.
KATCHA_S3_ENDPOINT_URL=https://CHANGE_ME_ACCOUNT_ID.r2.cloudflarestorage.com
KATCHA_S3_ACCESS_KEY=CHANGE_ME_R2_ACCESS_KEY
KATCHA_S3_SECRET_KEY=CHANGE_ME_R2_SECRET_KEY
KATCHA_S3_BUCKET=katcha-media-prod
KATCHA_S3_REGION=auto
KATCHA_S3_FORCE_PATH_STYLE=false

# Production authentication and encrypted provider credentials.
KATCHA_CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME_PERSISTENT_32_BYTE_OR_LONGER_KEY
KATCHA_CONTROL_API_TOKEN=CHANGE_ME_STRONG_CONTROL_TOKEN_AT_LEAST_32_CHARS
KATCHA_CONTROL_API_SCOPES=*
KATCHA_CONTROL_PRINCIPALS=[]

# AI/provider settings are intentionally placeholders. Preserve the currently
# selected routing policy when moving the existing installation.
KATCHA_AI_ENABLED=false
KATCHA_AI_EXECUTION_MODE=live
KATCHA_RESEARCH_ENABLED=true
KATCHA_AI_LIVE_ROUTING_MODE=free_first
KATCHA_CONVERSATION_PROVIDER=gemini
KATCHA_AGENT_PROVIDER=codex
KATCHA_ALLOW_PAID_OPENAI_FALLBACK=false
KATCHA_GEMINI_API_KEY=
KATCHA_OPENAI_API_KEY=

# YouTube OAuth must point to the final public HTTPS Katcha hostname.
KATCHA_YOUTUBE_CLIENT_ID=CHANGE_ME
KATCHA_YOUTUBE_CLIENT_SECRET=CHANGE_ME
KATCHA_YOUTUBE_REDIRECT_URI=https://CHANGE_ME_HOST/v1/integrations/youtube/oauth/callback
KATCHA_YOUTUBE_INCLUDE_MONETARY_SCOPE=false

# Hosted rendering uses the existing Remotion Lambda path. The renderer
# container is a bounded dispatch/poll gateway; encoding occurs in Lambda.
KATCHA_RENDERER_URL=http://renderer:8787
KATCHA_RENDER_BACKEND=lambda
KATCHA_AWS_EXPECTED_ACCOUNT_ID=CHANGE_ME_12_DIGIT_ACCOUNT_ID
KATCHA_AWS_PROFILE=katcha-automation
KATCHA_REMOTION_LAMBDA_REGION=us-east-1
KATCHA_REMOTION_LAMBDA_MEMORY_MB=3008
KATCHA_REMOTION_LAMBDA_FUNCTION_NAME=CHANGE_ME
KATCHA_REMOTION_LAMBDA_SERVE_URL=CHANGE_ME
KATCHA_REMOTION_STAGING_BUCKET=CHANGE_ME
KATCHA_REMOTION_STAGING_PREFIX=katcha-render-staging
KATCHA_REMOTION_LAMBDA_MAX_RETRIES=2

# Roles Anywhere host paths are optional until cloud AWS auth is installed.
KATCHA_AWS_SIGNING_HELPER_PATH=
KATCHA_AWS_CERT_PATH=
KATCHA_AWS_PRIVATE_KEY_PATH=

# Telegram can stay disabled until its production secret is installed.
KATCHA_TELEGRAM_ENABLED=false
KATCHA_TELEGRAM_BOT_TOKEN=
KATCHA_TELEGRAM_CHAT_ID=
KATCHA_TELEGRAM_ALLOWED_USER_ID=

KATCHA_LOG_LEVEL=INFO
