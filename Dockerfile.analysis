FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml README.md alembic.ini ./
RUN pip install --upgrade pip \
    && python -c 'import subprocess,tomllib; project=tomllib.load(open("pyproject.toml","rb"))["project"]; deps=project["dependencies"] + sum((project["optional-dependencies"][name] for name in ["ai","media"]), []); subprocess.check_call(["pip","install",*deps])'
COPY migrations ./migrations
COPY src ./src
RUN pip install -e . --no-deps

RUN useradd --create-home --uid 10001 katcha \
    && mkdir -p /tmp/katcha /home/katcha/.cache \
    && chown -R katcha:katcha /app /tmp/katcha /home/katcha/.cache
USER katcha

CMD ["python", "-m", "katcha.orchestration.analysis_worker"]
