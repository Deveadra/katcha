KATCHA_ENV=development
KATCHA_API_HOST=0.0.0.0
KATCHA_API_PORT=8000
KATCHA_DATABASE_URL=postgresql+psycopg://katcha:katcha@postgres:5432/katcha
KATCHA_TEMPORAL_HOST=temporal:7233
KATCHA_TEMPORAL_NAMESPACE=default
KATCHA_TEMPORAL_TASK_QUEUE=katcha-media
KATCHA_TEMPORAL_ANALYSIS_TASK_QUEUE=katcha-analysis
KATCHA_TEMPORAL_PRODUCTION_TASK_QUEUE=katcha-production
KATCHA_TEMPORAL_PUBLISHING_TASK_QUEUE=katcha-publishing
KATCHA_TEMPORAL_LONGFORM_TASK_QUEUE=katcha-longform
KATCHA_S3_ENDPOINT_URL=http://minio:9000
KATCHA_S3_ACCESS_KEY=katcha
KATCHA_S3_SECRET_KEY=katcha-local-secret
KATCHA_S3_BUCKET=katcha-media
KATCHA_S3_REGION=auto
KATCHA_S3_FORCE_PATH_STYLE=true
KATCHA_WORK_DIR=/tmp/katcha
KATCHA_ANALYSIS_FRAME_COUNT=6
KATCHA_WHISPER_MODEL=base.en
KATCHA_WHISPER_DEVICE=cpu
KATCHA_WHISPER_COMPUTE_TYPE=int8
KATCHA_OPENAI_API_KEY=
KATCHA_GEMINI_API_KEY=
KATCHA_AI_ENABLED=false
KATCHA_AI_BUDGET_USD_MONTHLY=25
KATCHA_TTS_PROFILE=openai_youth_v2
KATCHA_RENDERER_URL=http://renderer:8787
KATCHA_RENDER_WIDTH=1080
KATCHA_RENDER_HEIGHT=1920
KATCHA_RENDER_FPS=30
KATCHA_SOURCE_AUDIO_VOLUME=0.45
KATCHA_LONGFORM_RENDER_WIDTH=1920
KATCHA_LONGFORM_RENDER_HEIGHT=1080
KATCHA_LONGFORM_RENDER_FPS=30
KATCHA_LONGFORM_CANDIDATE_POOL_LIMIT=80
KATCHA_LONGFORM_MIN_SEGMENTS=8
KATCHA_LONGFORM_MAX_SEGMENTS=30
KATCHA_LONGFORM_DEFAULT_TARGET_SECONDS=720
KATCHA_LONGFORM_MAX_TARGET_SECONDS=1800
KATCHA_CREDENTIAL_ENCRYPTION_KEY=
KATCHA_YOUTUBE_CLIENT_ID=
KATCHA_YOUTUBE_CLIENT_SECRET=
KATCHA_YOUTUBE_REDIRECT_URI=http://localhost:8000/v1/integrations/youtube/oauth/callback
KATCHA_YOUTUBE_INCLUDE_MONETARY_SCOPE=false
KATCHA_YOUTUBE_DEFAULT_CATEGORY_ID=24
KATCHA_YOUTUBE_UPLOAD_CHUNK_MB=8
KATCHA_YOUTUBE_PROCESSING_POLL_SECONDS=30
KATCHA_YOUTUBE_PROCESSING_MAX_POLLS=120
KATCHA_YOUTUBE_ANALYTICS_OFFSETS_HOURS=1,6,24,72,168,720
KATCHA_YOUTUBE_DATA_API_KEY=
KATCHA_REDDIT_CLIENT_ID=
KATCHA_REDDIT_CLIENT_SECRET=
KATCHA_REDDIT_USER_AGENT=Katcha/0.1 trend-discovery
KATCHA_TREND_SOURCE_MAX_BACKOFF_SECONDS=21600
KATCHA_TREND_MIN_SOURCE_COVERAGE=0.75
KATCHA_TREND_OBSERVATION_BUCKET_SECONDS=300
KATCHA_TREND_COLLECTION_DEDUPE_WINDOW_SECONDS=300
KATCHA_TREND_POLL_LEASE_SECONDS=900
KATCHA_TREND_YOUTUBE_SEARCH_DAILY_LIMIT=100
KATCHA_TREND_YOUTUBE_CORE_DAILY_LIMIT=10000
KATCHA_LOG_LEVEL=INFO
# Set a strong random secret for hosted control-plane access.
# KATCHA_ENV=production requires a token for control requests.
KATCHA_CONTROL_API_TOKEN=
